# /etc/rascal/rascal.env   (sudo install -m 640 -o root -g rascal rascal.env.example /etc/rascal/rascal.env)
RASCAL_ENV=prod
RASCAL_HOST=127.0.0.1
RASCAL_PORT=8001
RASCAL_SECURE_COOKIES=true
RASCAL_PUBLIC_URL=https://cine.ejemplo.com
RASCAL_TRUSTED_PROXIES=127.0.0.1
RASCAL_DATA_DIR=/srv/rascal/var

# SQLite (un servidor, tráfico moderado): ruta ABSOLUTA, cuatro barras.
RASCAL_DATABASE_URL=sqlite:////srv/rascal/var/rascal.db
# PostgreSQL (varios procesos/servidores, búsqueda con pg_trgm):
# RASCAL_DATABASE_URL=postgresql+psycopg://rascal:CLAVE_LARGA@127.0.0.1:5432/rascal

# python3 -c "import secrets;print(secrets.token_urlsafe(48))"
RASCAL_SECRET_KEY=
RASCAL_SERVICE_KEY=

RASCAL_STREAMER_INTERNAL_URL=http://127.0.0.1:8001
RASCAL_STREAMER_PUBLIC_URL=https://cine.ejemplo.com
RASCAL_UI_PUBLIC_URL=https://cine.ejemplo.com

# P2P. Para no publicar la IP del VPS en los enjambres: RASCAL_STREAM_ENGINE=local (sin P2P) o
# RASCAL_LT_LISTEN_INTERFACES=<IP del túnel VPN>:6881 con enrutamiento por política (ver DEPLOY_LINUX.md).
RASCAL_STREAM_ENGINE=libtorrent
RASCAL_LT_LISTEN_PORT=6881
RASCAL_LT_ENABLE_PORT_MAPPING=false
RASCAL_ALLOW_FULL_TRANSCODE=false

RASCAL_SMTP_HOST=
RASCAL_SMTP_PORT=587
RASCAL_SMTP_USER=
RASCAL_SMTP_PASSWORD=
RASCAL_SMTP_SENDER=no-reply@cine.ejemplo.com

RASCAL_TMDB_API_KEY=
RASCAL_TMDB_REGION=MX
RASCAL_RATE_LIMIT_LOGIN=10/60
RASCAL_RATE_LIMIT_REGISTER=5/600
RASCAL_RATE_LIMIT_API=240/60
