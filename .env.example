# Copia este archivo a .env y ajusta. NUNCA subas .env al repositorio.
RASCAL_ENV=dev
RASCAL_DATA_DIR=./var
RASCAL_DATABASE_URL=sqlite:///./var/rascal.db
# Producción: RASCAL_DATABASE_URL=postgresql+psycopg://rascal:***@localhost:5432/rascal

# Secretos compartidos por la UI y el microservicio (genera con: python -c "import secrets;print(secrets.token_urlsafe(48))")
RASCAL_SECRET_KEY=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-chars
RASCAL_SERVICE_KEY=cambia-esto-tambien

# 2FA por correo (vacío = el código se imprime en la consola en desarrollo)
RASCAL_SMTP_HOST=
RASCAL_SMTP_PORT=587
RASCAL_SMTP_USER=
RASCAL_SMTP_PASSWORD=
RASCAL_SMTP_SENDER=no-reply@tu-dominio.com

# Importación de fichas desde TMDB (panel Partner). Acepta la API Key v3 o el token de lectura v4 (JWT).
RASCAL_TMDB_API_KEY=

# Streaming
RASCAL_STREAMER_INTERNAL_URL=http://127.0.0.1:8001
RASCAL_STREAMER_PUBLIC_URL=http://localhost:8001
RASCAL_UI_PUBLIC_URL=http://localhost:8501
RASCAL_STREAM_ENGINE=libtorrent          # "local" = sirve archivos de var/media/<info_hash>/ sin P2P
RASCAL_LT_LISTEN_PORT=6881
RASCAL_LT_ENABLE_DHT=true
RASCAL_LT_ENABLE_PORT_MAPPING=true
RASCAL_LT_DOWNLOAD_RATE_LIMIT=0
RASCAL_LT_UPLOAD_RATE_LIMIT=0
RASCAL_STREAM_HEAD_BYTES=10485760
RASCAL_STREAM_TAIL_BYTES=6291456
RASCAL_FFMPEG_PATH=ffmpeg
RASCAL_FFPROBE_PATH=ffprobe
RASCAL_ALLOW_FULL_TRANSCODE=false
